#!/usr/bin/env ruby
# exe/chiebukuro-mcp
require 'bundler/setup'
require_relative '../lib/chiebukuro_mcp'
require 'json'

CONFIG_PATH = File.expand_path('~/chiebukuro-mcp/chiebukuro.json').freeze

case ARGV[0]
when 'serve'
  unless File.exist?(CONFIG_PATH)
    warn "Config not found: #{CONFIG_PATH}"
    warn "Create #{CONFIG_PATH} with your database configuration."
    warn "Run 'chiebukuro-mcp inspect <db_path>' to generate a suggested config."
    exit 1
  end
  config   = JSON.parse(File.read(CONFIG_PATH, encoding: 'UTF-8'))
  embedder = ChiebukuroMcp::Embedder.new
  ChiebukuroMcp::Server.new(config: config, embedder: embedder).run
when 'inspect'
  db_path = ARGV[1]
  unless db_path
    warn "Usage: chiebukuro-mcp inspect <db_path>"
    exit 1
  end
  result = ChiebukuroMcp::Inspector.new(db_path).inspect_db
  puts JSON.pretty_generate(result)
else
  warn "Usage:"
  warn "  chiebukuro-mcp serve              # Start MCP server (reads #{CONFIG_PATH})"
  warn "  chiebukuro-mcp inspect <db_path>  # Inspect a SQLite database"
  exit 1
end
